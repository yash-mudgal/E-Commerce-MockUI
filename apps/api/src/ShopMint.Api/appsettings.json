{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "//": "Set via environment variables in every deployed environment: ConnectionStrings__App, ConnectionStrings__Platform, ConnectionStrings__Migrations. Never commit real credentials."
  },
  "Platform": {
    "StorefrontDomain": "shopmint.in"
  },
  "Auth": {
    "SessionCacheSeconds": 30
  },
  "RateLimiting": {
    "AuthPerMinute": 10
  },
  "Proxy": {
    "TrustAll": false,
    "KnownNetworks": []
  },
  "Database": {
    "MigrateOnStartup": false
  }
}
