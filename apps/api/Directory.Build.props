<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1515 (make types internal) conflicts with WebApplicationFactory/minimal-API style; CA1848/CA1873 logging perf rules deferred. -->
    <NoWarn>$(NoWarn);CA1515;CA1848;CA1873;CA1062;CA1711;CA1707;CA2007;CA1716;CA1720;CA1305;CA1310;CA1307;CA1309;CA1031;CA1724;CA1034;CA1819;CA1002;CA2227;CA1308;CA1812;CA5394;CA1861;CA1725;CA1304;CA1311</NoWarn>
  </PropertyGroup>
</Project>
