# Where the Next.js server reaches the ASP.NET Core API (server-side only).
API_URL=http://localhost:5080
# Hosts that serve the merchant app (everything else is treated as a storefront host).
APP_HOSTS=localhost,127.0.0.1,app.localhost
# Public URL of a storefront, for canonical links and sitemaps. Production: https://{host}
STOREFRONT_URL_TEMPLATE=http://{host}:3000
# Shared secret the API sends to /internal/revalidate after a store changes (same value as the API's Web__RevalidateSecret).
# Leave empty to turn the endpoint off. Never commit a real value.
REVALIDATE_SECRET=
# Public base URL of product images (the API's Media:PublicBaseUrl). Set at build time; a public CDN enables image resizing.
MEDIA_PUBLIC_URL=
# Origin browsers upload product images to (presigned PUTs): the S3 bucket endpoint in production, the local S3 test server (http://localhost:9000) in development.
# Needed at build time for the Content-Security-Policy, e.g. https://shopmint-media-prod.s3.ap-south-1.amazonaws.com
MEDIA_UPLOAD_ORIGIN=
# Shown on the signup form as "<subdomain>.<domain>".
NEXT_PUBLIC_STORE_DOMAIN=localhost:3000
